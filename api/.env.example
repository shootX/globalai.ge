APP_NAME=globalAI
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=ka
APP_FALLBACK_LOCALE=ka
APP_FAKER_LOCALE=ka_GE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=globalai
DB_USERNAME=globalai
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@globalai.ge"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ADMIN_ADDRESS=

CORS_ALLOWED_ORIGINS=http://localhost:3000,https://globalai.ge,https://www.globalai.ge

NEXT_REVALIDATE_URL=
NEXT_REVALIDATE_SECRET=

SANCTUM_EXPIRATION=
