{
  "name": "globalai-ge-e2e",
  "private": true,
  "scripts": {
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:mockup": "MOCKUP=1 BASE_URL=http://localhost:4173 playwright test -c e2e/playwright.config.ts --grep @mockup --project=chromium --project=mobile-chromium",
    "e2e:report": "playwright show-report e2e/playwright-report"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.6.0"
  }
}
