# მაგალითი (GitHub Actions). სხვა CI-ში იგივე ბრძანებებია — იხ. ქვემოთ "generic".
name: e2e
on: [pull_request]
jobs:
  e2e:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with: { node-version: 20 }
      - run: npm ci
      - run: npx playwright install --with-deps
      # აპის აწყობა/გაშვება (web/ + api/) — მონორეპოში მოერგება
      - run: npm --prefix web ci && npm --prefix web run build && (npm --prefix web start &) && npx wait-on http://localhost:3000
      - run: npx playwright test -c e2e/playwright.config.ts
        env: { CI: 'true', BASE_URL: 'http://localhost:3000' }
      - if: always()
        uses: actions/upload-artifact@v4
        with:
          name: playwright-report
          path: |
            e2e/playwright-report
            e2e/test-results
# generic (GitLab/Origin/Jenkins):
#   npm ci && npx playwright install --with-deps
#   CI=true BASE_URL=http://localhost:3000 npx playwright test -c e2e/playwright.config.ts
#   artifacts: e2e/playwright-report, e2e/test-results
